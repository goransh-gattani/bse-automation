# Settings for server/app.py. On Railway, add these under your service's
# Variables tab; don't commit real values. Railway sets PORT itself.

# Supabase dashboard -> Project Settings -> API (or "API Keys"):
SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. It is public by design (the page uses it).
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only if your Supabase project still uses the legacy JWT secret
# (Project Settings -> JWT Keys). Leave unset for the newer signing keys.
# SUPABASE_JWT_SECRET=

# Only let these email domains in, comma-separated. Recommended.
ALLOWED_EMAIL_DOMAINS=yourcompany.com

# "true" to also require each email to be in the allowed_users table
# (run supabase/allowlist.sql first).
USE_ALLOWLIST_TABLE=false

# For testing on your own computer without Supabase. Never set on Railway.
# AUTH_DISABLED=true
